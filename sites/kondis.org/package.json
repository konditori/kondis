{
  "name": "@kondis/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build:cf-output": "node ./scripts/build-cf-output.mjs",
    "deploy:dry-run": "pnpm build && pnpm build:cf-output && cf deploy --prebuilt --dry-run",
    "deploy": "pnpm build && pnpm build:cf-output && cf deploy --prebuilt",
    "build:cf-preview-output": "node ./scripts/build-cf-output.mjs --preview",
    "deploy:preview": "pnpm build && pnpm build:cf-preview-output && cf previews deploy --prebuilt"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "cf": "1.0.0-beta.12",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "4.136.0"
  }
}
