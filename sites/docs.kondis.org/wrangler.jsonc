{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kondis-docs",
  "preview_urls": true,
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "docs.kondis.org",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
