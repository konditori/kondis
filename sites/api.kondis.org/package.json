{
  "name": "@kondis/api-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "cf dev --port 3000",
    "build": "node scripts/build.mjs",
    "serve": "cf dev --port 3000",
    "clear": "rm -rf build",
    "build:cf-output": "node ../kondis.org/scripts/build-cf-output.mjs",
    "build:cf-preview-output": "node ../kondis.org/scripts/build-cf-output.mjs --preview",
    "deploy:dry-run": "pnpm build && pnpm build:cf-output && cf deploy --prebuilt --dry-run",
    "deploy": "pnpm build && pnpm build:cf-output && cf deploy --prebuilt",
    "deploy:preview": "pnpm build && pnpm build:cf-preview-output && cf previews deploy --prebuilt",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@scalar/api-reference": "^1.67.0"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.12",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "wrangler": "4.136.0"
  }
}
