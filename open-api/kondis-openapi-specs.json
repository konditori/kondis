{
  "openapi": "3.0.0",
  "paths": {
    "/ping": {
      "get": {
        "operationId": "ServerController_ping",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponseDto_Output"
                }
              }
            }
          }
        },
        "summary": "Health check endpoint",
        "tags": [
          "server"
        ]
      }
    },
    "/uploads/fit": {
      "post": {
        "operationId": "ImportController_uploadFit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": ".fit activity file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "FIT file stored; parsing is queued and happens asynchronously",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitUploadResponseDto_Output"
                }
              }
            }
          }
        },
        "summary": "Upload a FIT activity file",
        "tags": [
          "imports"
        ]
      }
    }
  },
  "info": {
    "title": "Kondis API",
    "description": "OpenAPI schema for the Kondis server",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PingResponseDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Health status of the API"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "FitUploadResponseDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Upload identifier, used to correlate the resulting activity"
          },
          "checksum": {
            "type": "string",
            "description": "Lowercase hex SHA-256 of the file contents"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Stored file size in bytes"
          },
          "duplicate": {
            "type": "boolean",
            "description": "True when identical content was already stored"
          }
        },
        "required": [
          "id",
          "checksum",
          "byteSize",
          "duplicate"
        ],
        "additionalProperties": false
      }
    }
  }
}
