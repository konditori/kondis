# Copy to deployment/demo/.env and fill in host-specific paths.
DEMO_DB_DATA_DIR=/srv/kondis-demo-db/data
DEMO_DB_BIND_ADDRESS=0.0.0.0
DEMO_DB_PORT=5432
DEMO_DB_DATABASE_NAME=kondis_demo

DEMO_DB_USERNAME_FILE=/srv/kondis-demo-db/secrets/username
DEMO_DB_PASSWORD_FILE=/srv/kondis-demo-db/secrets/password
