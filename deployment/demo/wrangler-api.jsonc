{
  "$schema": "../../server/node_modules/wrangler/config-schema.json",
  "name": "kondis-demo-api",
  "main": "../../server/src/cloudflare/entrypoint.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "cache": { "enabled": false },
  "placement": { "host": "db.demo.kondis.org:5432" },
  "workers_dev": false,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      { "name": "DEMO_LIVE_TRACKER", "class_name": "DemoLiveTracker" },
      { "name": "REALTIME", "class_name": "RealtimeDurableObject" },
    ],
  },
  "migrations": [
    {
      "tag": "demo-live-tracker-v1",
      "new_sqlite_classes": ["DemoLiveTracker"],
    },
    {
      "tag": "demo-live-tracker-v2",
      "new_sqlite_classes": ["RealtimeDurableObject"],
    },
  ],
  "services": [
    { "binding": "DEMO_LIVE_INGESTION", "service": "kondis-demo-api" },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ACTIVITY_PARSING_QUEUE",
        "queue": "kondis-demo-api-activity-parsing",
      },
      {
        "binding": "ACTIVITY_ENRICHMENT_QUEUE",
        "queue": "kondis-demo-api-activity-enrichment",
      },
      {
        "binding": "BACKGROUND_TASK_QUEUE",
        "queue": "kondis-demo-api-background-task",
      },
      {
        "binding": "IMAGE_PROCESSING_QUEUE",
        "queue": "kondis-demo-api-image-processing",
      },
      { "binding": "STORAGE_QUEUE", "queue": "kondis-demo-api-storage" },
    ],
    "consumers": [
      {
        "queue": "kondis-demo-api-activity-parsing",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 5,
        "max_concurrency": 3,
        "dead_letter_queue": "kondis-demo-api-activity-parsing-dlq",
      },
      {
        "queue": "kondis-demo-api-activity-parsing-dlq",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "kondis-demo-api-activity-enrichment",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 5,
        "max_concurrency": 3,
        "dead_letter_queue": "kondis-demo-api-activity-enrichment-dlq",
      },
      {
        "queue": "kondis-demo-api-activity-enrichment-dlq",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "kondis-demo-api-background-task",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 5,
        "max_concurrency": 3,
        "dead_letter_queue": "kondis-demo-api-background-task-dlq",
      },
      {
        "queue": "kondis-demo-api-background-task-dlq",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "kondis-demo-api-image-processing",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "kondis-demo-api-image-processing-dlq",
      },
      {
        "queue": "kondis-demo-api-image-processing-dlq",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "kondis-demo-api-storage",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "kondis-demo-api-storage-dlq",
      },
      {
        "queue": "kondis-demo-api-storage-dlq",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "KONDIS_DEMO_MEDIA_BASE_URL": "https://demo.kondis.org/demo-media/v1",
  },
}
