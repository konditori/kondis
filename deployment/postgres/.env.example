# Copy this file to .env on the database host. Keep .env out of Git.

KONDIS_DB_DATA_DIR=/srv/kondis-db/data
KONDIS_DB_PORT=5432
KONDIS_DB_DATABASE_NAME=kondis

# The migration role owns the schema and is never used by Hyperdrive.
KONDIS_DB_MIGRATOR_USERNAME=kondis_migrator
KONDIS_DB_MIGRATOR_USERNAME_FILE=/srv/kondis-db/secrets/migrator-username
KONDIS_DB_MIGRATOR_PASSWORD_FILE=/srv/kondis-db/secrets/migrator-password

# This role is used by Cloudflare Hyperdrive at runtime.
KONDIS_DB_RUNTIME_USERNAME=kondis_runtime
KONDIS_DB_RUNTIME_USERNAME_FILE=/srv/kondis-db/secrets/runtime-username
KONDIS_DB_RUNTIME_PASSWORD_FILE=/srv/kondis-db/secrets/runtime-password

# These must be a publicly trusted certificate and private key whose SAN
# contains the hostname used by Hyperdrive, for example db.example.com.
KONDIS_DB_TLS_CERT=/srv/kondis-db/tls/server.crt
KONDIS_DB_TLS_KEY=/srv/kondis-db/tls/server.key

POSTGRES_MAJOR_VERSION=17
VECTORCHORD_TAG=1.1.1
KONDIS_DB_STORAGE_TYPE=SSD
