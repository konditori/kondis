# Copy this file to .env on the database host. Keep .env out of Git.

KONDIS_DB_DATA_DIR=/srv/postgres/data
KONDIS_DB_PORT=5432
KONDIS_DB_DATABASE_NAME=kondis

# The migration role owns the schema and is never used by Hyperdrive.
KONDIS_DB_MIGRATOR_USERNAME=kondis_migrator
KONDIS_DB_MIGRATOR_USERNAME_FILE=/srv/postgres/secrets/migrator-username
KONDIS_DB_MIGRATOR_PASSWORD_FILE=/srv/postgres/secrets/migrator-password

# This role is used by Cloudflare Hyperdrive at runtime.
KONDIS_DB_RUNTIME_USERNAME=kondis_runtime
KONDIS_DB_RUNTIME_USERNAME_FILE=/srv/postgres/secrets/runtime-username
KONDIS_DB_RUNTIME_PASSWORD_FILE=/srv/postgres/secrets/runtime-password

# A stable self-signed certificate and private key. Upload server.crt to
# Hyperdrive as a CA certificate and use sslmode=verify-ca.
KONDIS_DB_TLS_CERT=/srv/postgres/tls/server.crt
KONDIS_DB_TLS_KEY=/srv/postgres/tls/server.key

POSTGRES_MAJOR_VERSION=17
VECTORCHORD_TAG=1.1.1
KONDIS_DB_STORAGE_TYPE=HDD
