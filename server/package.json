{
  "name": "kondis-server",
  "private": true,
  "version": "0.0.0",
  "description": "Kondis server backend",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/bin/start.js",
    "start:dev": "node scripts/start-dev-watch.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write --list-different .",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:medium": "vitest run -c test/vitest.config.medium.mjs",
    "test:watch": "vitest",
    "migrations": "node -r @swc-node/register scripts/run-typescript.cjs src/bin/migrations.ts",
    "migrate": "node -r @swc-node/register scripts/run-typescript.cjs src/bin/migrations.ts run",
    "db:reset-development-data": "node -r @swc-node/register scripts/run-typescript.cjs src/bin/reset-development-data.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/db/schema.generated.ts",
    "sync-open-api": "node -r @swc-node/register scripts/run-typescript.cjs src/bin/sync-open-api.ts",
    "third-party-licenses": "node -r @swc-node/register scripts/run-typescript.cjs src/bin/generate-third-party-notices.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.2",
    "@node-rs/xxhash": "^1.7.7",
    "@oazapfts/runtime": "^1.2.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.11.1",
    "fit-file-parser": "^5.0.2",
    "hono": "^4.13.5",
    "kysely": "^0.29.5",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0",
    "sharp": "^0.35.4",
    "unzipper": "^0.12.5",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.11.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "testcontainers": "^12.1.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
