{
  "name": "kondis-server",
  "private": true,
  "version": "0.0.0",
  "description": "Kondis server backend",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node --watch -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write --list-different .",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:medium": "vitest run -c test/vitest.config.medium.mjs",
    "test:watch": "vitest",
    "migrate": "node -r @swc-node/register src/bin/migrate.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/db/schema.generated.ts",
    "sync-open-api": "node -r @swc-node/register src/bin/sync-open-api.ts",
    "third-party-licenses": "node -r @swc-node/register src/bin/generate-third-party-notices.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.2.0",
    "@node-rs/xxhash": "^1.7.6",
    "@oazapfts/runtime": "^1.2.0",
    "fit-file-parser": "^4.1.0",
    "kysely": "^0.28.2",
    "multer": "^2.2.0",
    "nestjs-zod": "^5.0.1",
    "pg": "^8.13.1",
    "pg-boss": "^12.26.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.10",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.0.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.1.0",
    "testcontainers": "^11.7.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.28.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}