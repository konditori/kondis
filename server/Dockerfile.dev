ARG DEBIAN_RELEASE=trixie

FROM node:24.14.1-${DEBIAN_RELEASE}-slim@sha256:9707cd4542f400df5078df04f9652a272429112f15202d22b5b8bdd148df494f AS dev

ENV CI=1

ENV DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_RELEASE
ENV DEBIAN_RELEASE=${DEBIAN_RELEASE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11.20.0

WORKDIR /usr/src/app

RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /usr/src/app/server' \
    'exec pnpm start:dev' \
    > /usr/local/bin/kondis-dev \
    && chmod +x /usr/local/bin/kondis-dev \
    && printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /usr/src/app/web' \
    'pnpm exec svelte-kit sync' \
    'exec pnpm dev --host 0.0.0.0 --port 3000' \
    > /usr/local/bin/kondis-web \
    && chmod +x /usr/local/bin/kondis-web

EXPOSE 2293 3000

ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "-lc"]
CMD ["kondis-dev"]
