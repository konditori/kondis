ARG DEBIAN_RELEASE=trixie

FROM node:24.19.0-${DEBIAN_RELEASE}-slim AS dev

ENV CI=1

ENV DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_RELEASE
ENV DEBIAN_RELEASE=${DEBIAN_RELEASE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        git \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11.20.0

WORKDIR /usr/src/app

RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /usr/src/app/server' \
    'exec node scripts/start-dev-watch.mjs' \
    > /usr/local/bin/kondis-dev \
    && chmod +x /usr/local/bin/kondis-dev \
    && printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /usr/src/app/web' \
    'if git -C /usr/src/app rev-parse --git-dir >/dev/null 2>&1; then' \
    '  export PUBLIC_KONDIS_COMMIT="${PUBLIC_KONDIS_COMMIT:-$(git -C /usr/src/app rev-parse --short HEAD)}"' \
    '  export PUBLIC_KONDIS_BRANCH="${PUBLIC_KONDIS_BRANCH:-$(git -C /usr/src/app symbolic-ref --short -q HEAD || true)}"' \
    'fi' \
    'export PUBLIC_KONDIS_BUILD_TYPE="${PUBLIC_KONDIS_BUILD_TYPE:-development}"' \
    'pnpm --filter @kondis/sdk build' \
    'node node_modules/@sveltejs/kit/svelte-kit.js sync' \
    'exec node node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 3000' \
    > /usr/local/bin/kondis-web \
    && chmod +x /usr/local/bin/kondis-web

EXPOSE 2293 3000

ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "-lc"]
CMD ["kondis-dev"]
