# Copy this file to docker/.env and edit it to get started

DATA_LOCATION=/tmp/kondis

DB_HOSTNAME=database
DB_PORT=5432
DB_USERNAME=kondis
DB_PASSWORD=kondis
DB_DATABASE_NAME=kondis
# On first start, the server logs a generated setup token. Paste it into the setup dialog.
# Public registration is disabled unless explicitly enabled.
KONDIS_REGISTRATION_ENABLED=false
# Allow Vite development requests through the configured reverse-proxy host.
KONDIS_VITE_ALLOWED_HOSTS=true
