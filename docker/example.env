# Copy this file to docker/.env and edit it to get started

# The host location where application data is stored.
# PostgreSQL data is kept in a Docker-managed volume. PostgreSQL 18 creates
# its version-specific data directory inside this volume.
KONDIS_DATA_LOCATION=./data

# By default we disallow public registration for security reasons. 
# Only set this to true if you understand the implications.
# KONDIS_REGISTRATION_ENABLED=false
# KONDIS_TRUST_PROXY_HEADERS=false

# Optional fixed initial-setup secret (32-512 characters). If omitted, Kondis
# securely generates one and prints it once. Generate a value with:
#   openssl rand -hex 32
# KONDIS_SETUP_TOKEN=

# This is the database password, please change it to a random alphanumeric string
KONDIS_DB_PASSWORD=postgres

# These values can likely be kept as-is
KONDIS_DB_USERNAME=kondis
KONDIS_DB_DATABASE_NAME=kondis
