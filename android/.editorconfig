root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,toml}]
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

[app/src/main/java/app/kondis/ui/**/*.kt]
# Compose APIs intentionally use PascalCase, unlike ordinary Kotlin functions.
ktlint_standard_function-naming = disabled
